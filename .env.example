# Copy this file to .env.local and fill in your own values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=airline_db
# true for a hosted database like Aiven, leave both empty for your local one
DB_SSL=
# the hosted database's CA certificate on one line, with \n between its lines
DB_SSL_CA=

# Random string, at least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
